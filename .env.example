# Backend API base URL (include the /api suffix)
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# This app's own URL. Dev: http://localhost:3001. Vercel sets this automatically in production.
NEXTAUTH_URL="http://localhost:3001"

# NextAuth session encryption key. Generate one with: openssl rand -hex 32
NEXTAUTH_SECRET="replace_with_a_random_32_byte_hex_string"

# Optional — used for absolute links; falls back to the current origin.
NEXT_PUBLIC_FRONTEND_URL="http://localhost:3001"
